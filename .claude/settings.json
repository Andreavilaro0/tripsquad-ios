{
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git checkout main*)",
      "Bash(git branch -D *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/fabrica/*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(bun add*)",
      "Bash(pip install*)",
      "Bash(brew install*)",
      "Bash(swift package*)",
      "Bash(gem install*)",
      "Bash(curl * -d *)",
      "Bash(supabase *)",
      "Bash(vercel *)"
    ],
    "allow": [
      "Bash(bd *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git stash*)",
      "Bash(make verify)",
      "Bash(gitleaks *)",
      "Bash(semgrep *)",
      "Bash(swiftlint*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr list*)",
      "Bash(gh api repos/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
